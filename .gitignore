node_modules/
out/
dist/
*.log
.DS_Store
.env
.env.local
.vite/

# TypeScript incremental build cache (rewrites on every typecheck run — not source)
tsconfig.node.tsbuildinfo
tsconfig.web.tsbuildinfo

# Backup-restore staging dirs (created under repo root by integration tests when
# CWD happens to be the repo root; cleanup happens in the test teardown but a
# crash can leave one behind).
data-restore-*/

# Full-suite test output (generated by hand-rolled redirects during debugging).
full-test-output.txt

# Local research + debug artifacts — generated by GSD subagents, not part of the project source.
.planning/research/.cache/
.planning/debug/

# Phase 8 / Plan 04 — vendor license signing key + generated .lic files
# (the secrets/ directory is itself gitignored via the .gitignore rule
# below; the catch-all in secrets/.gitignore is defense-in-depth against
# a misconfigured top-level rule).
secrets/
*.private
*.lic
