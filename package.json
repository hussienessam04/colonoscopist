{
  "name": "colonoscopist",
  "version": "0.1.0",
  "description": "Local-first colonoscopy procedure recorder and reporting app",
  "main": "./out/main/index.js",
  "author": "Hussien Essam",
  "license": "UNLICENSED",
  "private": true,
  "productName": "Colonoscopist",
  "build": {
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:unit": "node scripts/run-vitest.cjs",
    "test:integration:smoke": "node scripts/run-vitest.cjs --run tests/integration/trim-smoke.test.ts",
    "test:integration:smoke:optin": "node scripts/run-vitest.cjs --run tests/integration/trim-smoke.test.ts",
    "_integration_smoke_note": "The trim-smoke test is opt-in via RUN_SMOKE=1. Default runs skip; CI runs with RUN_SMOKE=1 npm run test:integration:smoke:optin (or set RUN_SMOKE in the CI env).",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild && node scripts/fix-electron-path.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "32.3.3",
    "electron-vite": "2.3.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.19",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
