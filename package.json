{
  "name": "colonoscopist",
  "version": "0.1.0",
  "description": "Local-first colonoscopy procedure recorder and reporting app",
  "main": "./out/main/index.js",
  "author": "Hussien Essam",
  "license": "UNLICENSED",
  "private": true,
  "productName": "Colonoscopist",
  "build": {
    "appId": "com.colonoscopist.app",
    "productName": "Colonoscopist",
    "directories": {
      "output": "dist",
      "buildResources": "buildResources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      "src/main/pdf/fonts/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "buildResources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Colonoscopist"
    },
    "portable": {},
    "publish": {
      "provider": "github",
      "owner": "hussienessam",
      "repo": "colonoscopist",
      "releaseType": "release",
      "publishAutoUpdate": true
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build:icon": "node scripts/build-icon.mjs",
    "build": "npm run build:icon && electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --win nsis",
    "package:portable": "npm run build && electron-builder --win portable",
    "publish:gh": "electron-builder --publish always",
    "publish:dry": "electron-builder --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:unit": "node scripts/run-vitest.cjs",
    "test:integration:smoke": "node scripts/run-vitest.cjs --run tests/integration/trim-smoke.test.ts",
    "test:integration:smoke:optin": "node scripts/run-vitest.cjs --run tests/integration/trim-smoke.test.ts",
    "test:integration:smoke:phase7": "node scripts/run-vitest.cjs --run tests/integration/backup-restore-roundtrip.test.ts tests/integration/ar-pdf-magic.test.ts",
    "test:integration:smoke:phase8": "node scripts/run-vitest.cjs --run tests/integration/license-verify-roundtrip.test.ts tests/integration/license-trial-survives-reboot.test.ts tests/integration/license-gate-blocks-procedure.test.ts tests/integration/license-cache-invalidation-on-wizard.test.ts",
    "test:e2e": "playwright test",
    "_integration_smoke_note": "The trim-smoke test is opt-in via RUN_SMOKE=1. Default runs skip; CI runs with RUN_SMOKE=1 npm run test:integration:smoke:optin (or set RUN_SMOKE in the CI env).",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild && node scripts/fix-electron-path.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.3.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@playwright/test": "^1.50.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "32.3.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "2.3.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "png-to-ico": "^2.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.19",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
